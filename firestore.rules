rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roomHostId(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data.hostId;
    }

    function isHost(code) {
      return isSignedIn() && roomHostId(code) == request.auth.uid;
    }

    function hasValidExpiry(data, maximumTtl) {
      return data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + maximumTtl;
    }

    function hasRolloutExpiry(data, maximumTtl) {
      return (
          request.time < timestamp.date(2026, 8, 17)
          && !data.keys().hasAll(['expiresAt'])
        )
        || hasValidExpiry(data, maximumTtl);
    }

    function isValidActionBase(data) {
      return data.uid is string
        && data.uid == request.auth.uid
        && data.createdAt is int
        && data.createdAt > 0
        && data.processed == false
        && hasRolloutExpiry(data, duration.value(65, 'm'));
    }

    function isValidJoinAction(data) {
      return data.keys().hasOnly(['type', 'uid', 'name', 'img', 'createdAt', 'processed', 'expiresAt'])
        && data.type == 'join'
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 20
        && data.img in [
          'assets/avatar1.png',
          'assets/avatar2.png',
          'assets/avatar3.png',
          'assets/avatar4.png'
        ];
    }

    function isValidSimpleAction(data) {
      return data.keys().hasOnly(['type', 'uid', 'createdAt', 'processed', 'expiresAt'])
        && data.type in ['start', 'yaniv'];
    }

    function isValidCardRef(card) {
      return card is map
        && card.keys().hasOnly(['valueOrder', 'symbolType', 'symbolColor'])
        && card.valueOrder is int
        && card.valueOrder >= 0
        && card.valueOrder <= 13
        && card.symbolType is string
        && card.symbolType in ['clubs', 'diamonds', 'hearts', 'spades', 'joker']
        && card.symbolColor is string
        && card.symbolColor in ['black', 'red', ''];
    }

    function isValidMoveAction(data) {
      return data.keys().hasOnly(['type', 'uid', 'cards', 'cardToTake', 'createdAt', 'processed', 'expiresAt'])
        && data.type == 'move'
        && data.cards is list
        && isValidCardRefs(data.cards)
        && (data.cardToTake == null || isValidCardRef(data.cardToTake));
    }

    function isValidCardRefs(cards) {
      return cards.size() > 0
        && cards.size() <= 10
        && isValidCardRef(cards[0])
        && (cards.size() < 2 || isValidCardRef(cards[1]))
        && (cards.size() < 3 || isValidCardRef(cards[2]))
        && (cards.size() < 4 || isValidCardRef(cards[3]))
        && (cards.size() < 5 || isValidCardRef(cards[4]))
        && (cards.size() < 6 || isValidCardRef(cards[5]))
        && (cards.size() < 7 || isValidCardRef(cards[6]))
        && (cards.size() < 8 || isValidCardRef(cards[7]))
        && (cards.size() < 9 || isValidCardRef(cards[8]))
        && (cards.size() < 10 || isValidCardRef(cards[9]));
    }

    match /rooms/{code} {

      // Public room summary: sanitized game state, participant/host identities and room status.
      // Never contains the deck or any player's hand. Any signed-in user who knows the exact
      // room code may read it (no `list`, so rooms cannot be enumerated); only the host may write
      // it, and a room's host cannot be changed after creation.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && hasRolloutExpiry(request.resource.data, duration.value(65, 'm'));
      allow update: if isSignedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId
        && hasRolloutExpiry(request.resource.data, duration.value(65, 'm'));
      allow delete: if false;

      // Host-only complete GameState (deck, every hand, everything). Never readable by anyone
      // else - only the host's own browser needs it, to resume authoritative processing.
      match /private/{document=**} {
        allow read: if isHost(code);
        allow write: if isHost(code)
          && hasRolloutExpiry(request.resource.data, duration.value(65, 'm'));
      }

      // One document per participant containing their real cards. Readable only by that
      // participant and the host; writable only by the host (who republishes hands after every
      // authoritative state change).
      match /hands/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isHost(code));
        allow write: if isHost(code)
          && hasRolloutExpiry(request.resource.data, duration.value(65, 'm'));
      }

      // Every browser owns one short-lived heartbeat document. The host may list these records
      // to remove disconnected players from a lobby, while players cannot impersonate each other.
      match /presence/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isHost(code));
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'lastSeenAt', 'expiresAt'])
          && request.resource.data.lastSeenAt is int
          && hasRolloutExpiry(request.resource.data, duration.value(10, 'm'));
        allow delete: if isSignedIn() && (request.auth.uid == uid || isHost(code));
      }

      // Join/move/yaniv/start commands. Anyone signed in may submit a command as themselves
      // (including a join request before they are a room participant), but only as an unprocessed
      // action they cannot mark as already handled. Only the host reads and processes the queue,
      // and only the host may flip `processed` once a command has been applied.
      match /actions/{actionId} {
        allow create: if isSignedIn()
          && isValidActionBase(request.resource.data)
          && (
            isValidJoinAction(request.resource.data)
            || isValidSimpleAction(request.resource.data)
            || isValidMoveAction(request.resource.data)
          );
        allow read: if isHost(code);
        allow update: if isHost(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processed', 'expiresAt'])
          && request.resource.data.processed == true
          && hasRolloutExpiry(request.resource.data, duration.value(10, 'm'));
        allow delete: if false;
      }
    }
  }
}
